    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModified">IsThereAnyDeal Collection Sync Modified</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedRefreshLoginStatus">Refresh</sys:String>
