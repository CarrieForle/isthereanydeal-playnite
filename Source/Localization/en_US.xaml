    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedLabelNote">Note</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxRemoveWaitlist">Remove games from Waitlist after sync</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxSkipNoSource">Skip manually added games</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxSkipNoSourceToolTip" xml:space="preserve">Skip games whose "Source" field empty which is the default for manually added games. 
If you manually set a game's source, it would not be skipped by this option.</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxRedeemEpic">Mark games from Epic Games Store as redeemed</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxFilterFaileds">Apply filter to games that are failed to sync</sys:String>
