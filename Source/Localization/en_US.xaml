    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxImportModeCaption">For games already collected:</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxImportModeSkip">Skip</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxImportModeReplace">Replace</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedLabelTags">Tags (separated by comma)</sys:String>
