<?xml version="1.0"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModified">IsThereAnyDeal Collection Sync</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedRefreshLoginStatus">重新整理</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxImportModeCaption">若同步的遊戲已在收藏庫：</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxImportModeSkip">跳過該遊戲</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxImportModeReplace">取代該遊戲</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedLabelTags">標籤（以半形逗號 「,」 分隔）</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedTagsTooltip">例如: tag1,tag2,tag3</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedLabelNote">筆記</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxRemoveWaitlist">同步後將遊戲從Waitlist移除</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxSkipNoSource">跳過手動新增的遊戲</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxSkipNoSourceToolTip" xml:space="preserve">跳過沒有標記「來源」的遊戲。Playnite預設不會對手動新增的遊戲標記來源
若您為一個遊戲手動新增了來源，它就不會因為這個選項而被跳過同步</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxRedeemEpic">將Epic的遊戲標記為「已領取」</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxFilterFaileds">過濾同步失敗的遊戲</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxFilterFailedsToolTip" xml:space="preserve">Playnite會在主畫面過濾出同步失敗的遊戲。這個選項不會套用至因收藏庫更新而產生的同步</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxRunOnLibraryUpdate">每當收藏庫更新後就自動開始同步</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxRunOnLibraryUpdateToolTip" xml:space="preserve">當收藏庫更新後，會嘗試對新增的遊戲進行同步
這個同步會在背景處理，同步完成後會收到通知</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxSyncDuplicateHider">同步多個商店的遊戲（DuplicateHider）</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxSyncDuplicateHiderToolTip" xml:space="preserve">當你選擇一個遊戲進行同步，所有該遊戲的商店版本也會被同步，而不用特別去選取它們
若您沒有安裝DuplicateHider插件，則這個選項的設置與否沒有任何影響</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedCheckBoxSyncHidden">同步隱藏的遊戲（只適用於「匯入所有遊戲」功能）</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedMainMenuImport">匯入所有遊戲</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedGameMenuImport">匯入至IsThereAnyDeal收藏庫</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedImportMessageMultiple" xml:space="preserve">正在匯入{0}款遊戲至IsThereAnyDeal收藏庫...
這應該只要花幾秒鐘...</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedImportMessageSingle" xml:space="preserve">正在匯入{0}至IsThereAnyDeal收藏庫...
這應該只要花幾秒鐘...</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedImportSkipNoSource" xml:space="preserve">「{0}」為手動新增，在目前的設定下會被跳過同步。是否要將這次同步以例外處理強制執行？

小技巧: 若不想再看到類似的訊息, 可以在插件設定中取消該選項。</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedImportSucceedMultiple">成功匯入{0}款遊戲</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedImportSucceedSingle">成功匯入{0}</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedImportFailureMultiple">無法匯入{0}款遊戲</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedImportFailureSingle">無法匯入{0}</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedImportSkippedMultiple">跳過{0}款遊戲</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedImportSkippedSingle">跳過{0}</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedImportMixed" xml:space="preserve">已處理{0}款遊戲
成功：{1}
跳過：{2}
失敗：{3}</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedErrorCaption">IsThereAnyDeal Collection Sync錯誤</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedErrorMessageNotLoggedIn"
            xml:space="preserve">您尚未登入至IsThereAnyDeal

是否要打開設定以進行登入？（登入後，您需要再重新一次加入遊戲）</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedNetworkError" xml:space="preserve">發生了連線問題。請確認您的網路連線是否正常：

{0}

請稍後再試。</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedImportError" xml:space="preserve">同步時發生錯誤：

{0}

請稍後再試。</sys:String>
    <sys:String x:Key="LOCIsThereAnyDealCollectionSyncModifiedAuthenticationError" xml:space="preserve">登入時發生錯誤：

{0}
        
請稍後再試。</sys:String>
</ResourceDictionary>